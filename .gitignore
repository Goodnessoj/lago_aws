# Terraform working directories and state
**/.terraform/
terraform/modules/**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Saved plans and crash logs
*.tfplan
crash.log
crash.*.log

# Local Terraform inputs; commit only sanitized examples
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example

# Environment files and credentials
.env
.env.*
!.env.example
.aws/
*.pem
*.key
.vault_pass*
vault-password*

# Local editor and OS files
.vscode/
.DS_Store
.codex
Thumbs.db

# Private state backups and local review artifacts
.local/
*.tfplan.json

# Local project documentation
/docs/

# Python controller bytecode
**/__pycache__/
*.pyc

# Local Ansible inventory
ansible/inventories/dev/hosts.yml
ansible/inventories/dev/application.yml
