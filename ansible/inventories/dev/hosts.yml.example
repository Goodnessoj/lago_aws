---
all:
  children:
    lago:
      hosts:
        i-00000000000000000:
          ansible_aws_ssm_instance_id: i-00000000000000000
          lago_data_volume_id: vol-00000000000000000
      vars:
        ansible_connection: amazon.aws.aws_ssm
        ansible_aws_ssm_region: us-east-2
        ansible_aws_ssm_bucket_name: lago-dev-ssm-example
        ansible_aws_ssm_bucket_sse_mode: AES256
        ansible_python_interpreter: /usr/bin/python3
        ansible_become: true
        ansible_become_user: root
        lago_data_mount_path: /srv/lago-data
